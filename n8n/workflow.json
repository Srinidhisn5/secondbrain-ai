        "jsCode": "const response = $input.item.json;\nlet ocrText = '';\ntry {\n  ocrText = response.responses?.[0]?.textAnnotations?.[0]?.description || '';\n} catch (e) {\n  ocrText = '';\n}\n\nreturn [{ json: { ...$('Compute SHA256 Hash').item.json, ocr_text: ocrText.trim() }, binary: $('Compute SHA256 Hash').item.binary }];"
      },
      "id": "62428f0a-13ba-4f25-8435-5ca5b49b0632",
      "name": "Extract OCR Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const ocrText = ($json.ocr_text || '').toLowerCase();\n\nconst sensitivePatterns = [\n  // OTP / one-time password + numeric code\n  /\\b(?:otp|one[- ]time password)\\b[\\s\\S]{0,30}\\b\\d{4,8}\\b/i,\n  /\\b\\d{4,8}\\b[\\s\\S]{0,30}\\b(?:otp|one[- ]time password)\\b/i,\n\n  // Verification code + numeric code\n  /\\bverification code\\b[\\s\\S]{0,30}\\b\\d{4,8}\\b/i,\n  /\\b\\d{4,8}\\b[\\s\\S]{0,30}\\bverification code\\b/i,\n\n  // Explicit OTP warning\n  /do not share[\\s\\S]{0,30}(?:otp|one[- ]time password)/i,\n\n  // CVV/CVC\n  /\\b(?:cvv|cvc)\\b\\s*[:=-]?\\s*\\d{3,4}\\b/i,\n\n  // PIN\n  /\\bpin\\b\\s*[:=-]?\\s*\\d{4,6}\\b/i,\n\n  // Bank account number\n  /\\b(?:account number|account no|a\\/c no)[\\s\\S]{0,20}\\b\\d{8,18}\\b/i,\n\n  // Credit/debit card number\n  /\\b(?:\\d[ -]*?){13,19}\\b/i\n];\n\nconst isSensitive = sensitivePatterns.some(\n  pattern => pattern.test(ocrText)\n);\n\nreturn [{\n  json: {\n    ...$json,\n    is_sensitive: isSensitive\n  },\n  binary: $input.item.binary\n}];"
      },
