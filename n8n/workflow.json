    {
      "parameters": {
        "jsCode": "const category = $json.category || 'Other';\nconst date = new Date().toISOString().split('T')[0];\n\nconst desc = ($json.filename_description || 'screenshot')\n  .replace(/[^a-z0-9-]/gi, '-')\n  .replace(/-+/g, '-')\n  .replace(/^-|-$/g, '');\n\nconst originalName = $json.name || '';\nconst match = originalName.match(/\\.([a-z0-9]+)$/i);\nconst extension = match ? match[1].toLowerCase() : 'png';\n\nconst newFilename = `${category}_${date}_${desc}.${extension}`;\n\nreturn [{\n  json: {\n    ...$json,\n    new_filename: newFilename,\n    target_folder: category\n  },\n  binary: $input.item.binary\n}];"
      },
